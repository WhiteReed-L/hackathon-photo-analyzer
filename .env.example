# ── OpenAI ───────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
# 官方API不需要改，中转站改成对应地址
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=dall-e-3

# ── Upload ───────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_RATE_LIMIT=30/minute

# ── Database ─────────────────────────────────────
DATABASE_PATH=photos.db
DB_POOL_SIZE=5
DB_BUSY_TIMEOUT_MS=5000
